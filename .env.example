# Frontend env vars — these get compiled into the client-side bundle by Vite,
# so ONLY put publishable/non-secret values here. Never add API keys for
# OpenRouter/Gemini/Groq etc. here — those belong in server/.env instead.

# Supabase project URL + anon/public key (safe to expose client-side by design)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API base URL (the Express server from /server)
VITE_API_BASE_URL=http://localhost:4000

# Google OAuth client ID (safe to expose client-side by design)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
