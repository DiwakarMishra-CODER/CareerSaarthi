# Server
PORT=4000

# Supabase (required — server exits on startup if these are missing)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter (server-side only — used by /api/ai/generate, /api/resumes/analyze, /api/profiles/analyze-linkedin)
OPENROUTER_API_KEY=your_openrouter_api_key

# Gemini (server-side only — used by /api/ai/gemini; add as many as you have, keys are pooled and rotated on 429)
GEMINI_API_KEY_1=your_gemini_api_key

# Google OAuth (same client ID as the frontend's VITE_GOOGLE_CLIENT_ID, no VITE_ prefix here —
# used server-side to verify the Google idToken in /api/auth/google)
GOOGLE_CLIENT_ID=your_google_client_id

# Adzuna (server-side only — used by GET /api/jobs/search; without these, that route
# falls back to a hardcoded 4-job mock list instead of real listings)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
